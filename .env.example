# Pluto3D backend environment template
# Public frontend runtime values belong in frontend/app-config.js

PORT=8000

# Generation providers
REPLICATE_API_TOKEN=your_replicate_token_here
MESHY_API_KEY=your_meshy_api_key_here

# Auth and plan resolution
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
PLUTO_PREMIUM_EMAILS=your-premium-email@example.com

# Billing
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_PREMIUM_PRICE_ID=price_your_premium_monthly_price_id_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_SUCCESS_URL=https://www.customer-domain.com/?billing=success
STRIPE_CANCEL_URL=https://www.customer-domain.com/?billing=cancel
STRIPE_PORTAL_RETURN_URL=https://www.customer-domain.com/?billing=portal

# Subscription persistence
# Use `local` for temporary scaffold mode.
# Switch to `supabase` for production persistence after the schema is applied.
PLUTO_SUBSCRIPTION_STORE=local
PLUTO_BILLING_STATE_FILE=backend/data/billing_state.json
